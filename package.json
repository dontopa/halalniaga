{
  "name": "halalniaga",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HALALNiaga \u2014 a digital halal ecosystem for small food vendors.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "i18n:check": "node scripts/check-i18n.mjs",
    "deploy": "npm run deploy:pages",
    "screenshots": "node scripts/screenshots.mjs",
    "deploy:pages": "npm run build && node scripts/prepare-pages.mjs && node scripts/deploy-pages.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "og": "node scripts/build-og.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.157.0"
  }
}
